# ============================================================================
# VEDINKA APPLICATION ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================


# ============================================================================
# STORAGE BACKEND CONFIGURATION
# ============================================================================
# Choose one of: 'local', 'azure', 's3'
# Default: 'local'
STORAGE_BACKEND=local


# ____________________________________________________________________________
# LOCAL STORAGE (STORAGE_BACKEND=local)
# ____________________________________________________________________________
# Uncomment and set these for local filesystem storage
# STATIC_ROOT=/path/to/static
# MEDIA_ROOT=/path/to/media


# ____________________________________________________________________________
# AZURE BLOB STORAGE (STORAGE_BACKEND=azure)
# ____________________________________________________________________________
# Uncomment and fill these for Azure Blob Storage

# Azure storage account name (e.g., "myaccount")
# AZURE_ACCOUNT_NAME=

# Azure storage account key (primary or secondary key)
# AZURE_ACCOUNT_KEY=

# Full Azure connection string (alternative to account key)
# AZURE_CONNECTION_STRING=DefaultEndpointProtocol=https;AccountName=...

# Container names (default: 'static' and 'media')
# AZURE_CONTAINER_STATIC=static
# AZURE_CONTAINER_MEDIA=media


# ____________________________________________________________________________
# AWS S3 STORAGE (STORAGE_BACKEND=s3)
# ____________________________________________________________________________
# Uncomment and fill these for AWS S3 Storage
# 
# SECURITY: Use IAM user credentials restricted to S3 only
# See STORAGE_CONFIG.md for detailed setup instructions

# AWS access key ID (from IAM user 'vedinka-app')
# AWS_ACCESS_KEY_ID=

# AWS secret access key (from IAM user 'vedinka-app')
# AWS_SECRET_ACCESS_KEY=

# S3 bucket name (e.g., "my-app-bucket")
# AWS_STORAGE_BUCKET_NAME=

# AWS region (default: 'us-east-1')
# AWS_S3_REGION_NAME=us-east-1

# Custom domain for S3 URLs (optional, e.g., "cdn.example.com")
# AWS_S3_CUSTOM_DOMAIN=

# Additional S3 object parameters as JSON string (optional)
# Example: {"CacheControl": "max-age=86400", "ACL": "public-read"}
# AWS_S3_OBJECT_PARAMETERS={}

# ____________________________________________________________________________
# S3 APP IDENTIFICATION (for access control and audit logging)
# ____________________________________________________________________________
# These identify this application in CloudTrail and object metadata

# Application identifier for this deployment (default: 'vedinka-app')
# Used in CloudTrail logs and S3 object metadata
# APP_ID=vedinka-app

# Application version (default: '1.0.0')
# Tracked in S3 object metadata for data lineage
# APP_VERSION=1.0.0

# Deployment environment (default: 'development')
# Options: 'development', 'staging', 'production'
# APP_ENVIRONMENT=production


# ____________________________________________________________________________
# RAZORPAY PAYMENT GATEWAY
# ____________________________________________________________________________
RAZORPAY_KEY=your-razorpay-public-key
RAZORPAY_SECRET=your-razorpay-secret-key


# ____________________________________________________________________________
# RABBITMQ / CELERY CONFIGURATION
# ____________________________________________________________________________
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
CELERY_HOST=rabbitmq-mgmt


# ____________________________________________________________________________
# EMAIL CONFIGURATION
# ____________________________________________________________________________
# Gmail
# GMAIL_EMAIL=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password

# Outlook
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
OUTLOOK_TENANT_ID=your_outlook_tenant_id


# ____________________________________________________________________________
# APPLICATION SETTINGS
# ____________________________________________________________________________
COMPANY_NAME=Samanyastra
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
